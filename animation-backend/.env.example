# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git, so the secrets never reach GitHub.

# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_).
SUPABASE_SECRET_KEY=

# Optional: Google sign-in (see README). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
